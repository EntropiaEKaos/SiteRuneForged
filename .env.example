# Exact SiteRuneForged deployment identity. Required for certified deploys.
# Must remain server-side.
# On Vercel Git deployments these may be omitted when System Environment
# Variables are enabled: VERCEL_GIT_COMMIT_SHA + VERCEL_ENV are used safely.
RUNEFORGE_PORTAL_DEPLOY_SHA=
RUNEFORGE_PORTAL_DEPLOY_ENV=

# Server-side public RuneForge API origin.
# Example: https://api.runeforge.example
RUNEFORGE_API_URL=
RUNEFORGE_GAME_URL=

# Optional fail-closed pin for the exact certified RuneForgedTCG runtime commit.
# Must be a full 40-character Git SHA. Server-side only.
RUNEFORGE_EXPECTED_DEPLOY_SHA=

# Optional separate administrative origin.
# Falls back to RUNEFORGE_API_URL when omitted.
RUNEFORGE_ADMIN_API_URL=
