{
  "name": "runeforge-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "visual:test": "playwright test",
    "contract:test": "node tests/contracts.mjs && node tests/knowledge-snapshot.mjs && node tests/portal-experience-3.mjs",
    "ci:install": "npm ci --no-audit --no-fund",
    "release:preflight": "node scripts/portal-release-preflight.mjs",
    "production:build": "npm run release:preflight && npm run build"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.10.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": "22.23.x"
  }
}
